# =====================================================================
# Variables del docker-compose.
# Copiar este archivo como .env (que NO se sube al repositorio) y reemplazar los valores.
# =====================================================================

# Usuario de Docker Hub donde están publicadas las imágenes y versión a usar.
# 3.0.0 es la versión del Sprint 3 (con eureka-server y api-gateway). La 1.0.0 es la del Sprint 2.
DOCKERHUB_USER=macostag26
IMAGE_TAG=3.0.0
# Versión de la imagen del frontend (Sprint 4).
FRONTEND_TAG=1.0.0

# Credenciales de las tres bases MySQL (cada servicio tiene la suya).
DB_USER=logitrack
DB_PASSWORD=cambiar-esta-clave
MYSQL_ROOT_PASSWORD=cambiar-esta-clave-de-root

# Clave con la que security-service firma los JWT (HS256) y el api-gateway, shipment y courier los validan.
# OBLIGATORIA, con al menos 32 caracteres: si falta o es corta, los servicios no arrancan.
# Generar una con:  openssl rand -base64 48
JWT_SECRET=cambiar-por-una-clave-larga-de-al-menos-32-caracteres

# Repositorio con los archivos de configuración que lee el config-server (opcional).
# CONFIG_REPO_URI=https://github.com/maxiacostag-cloud/logitrack-config.git
# CONFIG_REPO_BRANCH=main

# Orígenes permitidos para CORS en el api-gateway, separados por coma (opcional).
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
