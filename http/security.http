### =====================================================================
### security-service - usuarios, login y JWT (por el api-gateway, puerto 8066)
###
### Es el primer archivo que hay que correr: guarda en variables globales los tokens que usan los demás.
### El ADMIN y el REPARTIDOR son usuarios de demo que security-service crea al arrancar (S4-14), con la
### contraseña de USUARIOS_DEMO_PASSWORD del .env (gateway123 en el .env.example). Los CLIENTES se registran
### acá, porque el registro público ahora solo crea clientes.
### Compatible con IntelliJ HTTP Client.
### =====================================================================

@security = http://localhost:8066
@token = token-de-prueba
@clienteA = token-de-prueba
@clienteB = token-de-prueba
@repartidor = token-de-prueba
@brian = 3f6c1a52-8e0b-4d7a-9c11-0a1b2c3d4e01

### ---------------------------------------------------------------------
### 1. ADMIN
### ---------------------------------------------------------------------

### 1.1. Login del ADMIN de demo -> 200
POST {{security}}/api/v1/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "gw.admin",
  "password": "gateway123"
}

> {%
    client.global.set("token", response.body.token);
    client.test("Token de ADMIN guardado", function () {
        client.assert(response.status === 200, "Se esperaba 200; revisar USUARIOS_DEMO_PASSWORD en el .env");
        client.assert(response.body.role === "ADMIN", "Rol " + response.body.role);
    });
%}

### 1.2. S4-14: registrarse pidiendo rol ADMIN crea un CLIENTE -> 201 (409 si ya se corrió antes)
POST {{security}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "quiere.ser.admin",
  "email": "quiere.ser.admin@logitrack.test",
  "password": "admin12345",
  "rol": "ADMIN"
}

> {%
    client.test("El registro público no da ADMIN", function () {
        client.assert(response.status === 201 || response.status === 409, "Status " + response.status);
        if (response.status === 201) {
            client.assert(response.body.role === "CLIENTE", "Rol " + response.body.role);
        }
    });
%}

### 1.3. Datos del usuario del token -> 200
GET {{security}}/api/v1/auth/me
Authorization: Bearer {{token}}

### ---------------------------------------------------------------------
### 2. CLIENTES y REPARTIDOR (los usa cliente.http)
### ---------------------------------------------------------------------

### 2.1. Alta del CLIENTE A (si ya existe da 409: usar el login 2.5) -> 201
POST {{security}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "cliente.a",
  "email": "cliente.a@logitrack.test",
  "password": "cliente123"
}

> {%
    client.global.set("clienteA", response.body.token);
%}

### 2.2. Alta del CLIENTE B -> 201
POST {{security}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "cliente.b",
  "email": "cliente.b@logitrack.test",
  "password": "cliente123"
}

> {%
    client.global.set("clienteB", response.body.token);
%}

### 2.3. Login del REPARTIDOR de demo, vinculado a Brian Abalos (que vive en courier-service) -> 200
### El claim repartidorId del token sale de acá; sin él, el repartidor no puede listar envíos.
POST {{security}}/api/v1/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "gw.repartidor",
  "password": "gateway123"
}

> {%
    client.global.set("repartidor", response.body.token);
    client.test("Token de REPARTIDOR guardado", function () {
        client.assert(response.body.role === "REPARTIDOR", "Rol " + response.body.role);
    });
%}

### 2.4. S4-14: registrarse como REPARTIDOR crea un CLIENTE sin repartidor -> 201 (409 si ya se corrió)
POST {{security}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "quiere.ser.repartidor",
  "email": "quiere.ser.repartidor@logitrack.test",
  "password": "repartidor123",
  "rol": "REPARTIDOR",
  "repartidorId": "{{brian}}"
}

> {%
    client.test("El registro público no da REPARTIDOR", function () {
        client.assert(response.status === 201 || response.status === 409, "Status " + response.status);
        if (response.status === 201) {
            client.assert(response.body.role === "CLIENTE", "Rol " + response.body.role);
        }
    });
%}

### 2.5. Login del CLIENTE A (alternativa al alta) -> 200
POST {{security}}/api/v1/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "cliente.a",
  "password": "cliente123"
}

> {%
    client.global.set("clienteA", response.body.token);
%}

### 2.6. Login del CLIENTE B (alternativa al alta) -> 200
POST {{security}}/api/v1/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "cliente.b",
  "password": "cliente123"
}

> {%
    client.global.set("clienteB", response.body.token);
%}

### 2.7. Login del CLIENTE de demo -> 200
POST {{security}}/api/v1/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "gw.cliente",
  "password": "gateway123"
}

### 2.8. Login con el email en lugar del usuario -> 200
POST {{security}}/api/v1/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "cliente.a@logitrack.test",
  "password": "cliente123"
}

### ---------------------------------------------------------------------
### 3. CASOS DE ERROR
### ---------------------------------------------------------------------

### 3.1. Contraseña incorrecta -> 401 "Credenciales inválidas"
POST {{security}}/api/v1/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "gw.admin",
  "password": "clave-incorrecta"
}

### 3.2. Usuario inexistente -> 401 (mismo mensaje y mismo tiempo que el anterior)
POST {{security}}/api/v1/auth/login
Content-Type: application/json

{
  "usernameOrEmail": "no.existe",
  "password": "cualquier-clave"
}

### 3.3. Usuario ya registrado -> 409
POST {{security}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "gw.admin",
  "email": "otro@logitrack.test",
  "password": "admin12345"
}

### 3.4. Contraseña demasiado corta (mínimo 8) -> 400 con invalid-params
POST {{security}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "usuario.corto",
  "email": "usuario.corto@logitrack.test",
  "password": "123"
}

### 3.5. Email inválido -> 400
POST {{security}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "usuario.mail",
  "email": "esto-no-es-un-mail",
  "password": "admin12345"
}

### 3.6. /me sin token -> 401
GET {{security}}/api/v1/auth/me

### 3.7. /me con un token inventado -> 401
GET {{security}}/api/v1/auth/me
Authorization: Bearer esto.no.es.un.jwt
